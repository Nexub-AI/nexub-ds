{
  "name": "nexub-ds",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/release-version.mjs",
    "release": "turbo build --filter='./packages/*' && changeset publish",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "check:size": "node scripts/check-size.mjs",
    "check:release-policy": "node scripts/check-changesets.mjs && node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "postcss": "^8.5.30",
      "nanoid@3": "^3.3.20",
      "source-map-js": "^1.2.2",
      "postcss-selector-parser@6": "^7.1.6",
      "esbuild": "^0.28.2",
      "sharp": "^0.35.5"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}

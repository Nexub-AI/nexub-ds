{
  "name": "nexub-ds",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/release-version.mjs && pnpm ai-docs",
    "release": "turbo build --filter='./packages/*' && changeset publish",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "check:size": "node scripts/check-size.mjs",
    "check:release-policy": "node scripts/check-changesets.mjs && node --test scripts/*.test.mjs",
    "ai-docs": "node --experimental-strip-types --no-warnings scripts/build-ai-docs.mjs",
    "ci:local": "pnpm audit --prod --audit-level=high && pnpm turbo build --filter='./packages/*' && pnpm check:size && pnpm --filter @nexub/docs build && pnpm check:release-policy && pnpm ai-docs --check && node apps/docs/scripts/native-props.mjs --check && pnpm turbo typecheck && pnpm turbo lint && pnpm turbo test",
    "ci:local:visual": "pnpm --filter @nexub/react build-storybook --quiet && pnpm --filter @nexub/react test:visual:docker"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "0.15.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "postcss": "^8.5.30",
      "nanoid@3": "^3.3.20",
      "source-map-js": "^1.2.2",
      "postcss-selector-parser@6": "^7.1.6",
      "esbuild": "^0.28.2",
      "sharp": "^0.35.5",
      "body-parser@2": "^2.4.0",
      "@expo/cli>zod": "^4.6.6"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}

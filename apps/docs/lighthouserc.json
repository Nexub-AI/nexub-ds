{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-static.mjs out 4173",
      "startServerReadyPattern": "Serving",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/components/button",
        "http://localhost:4173/foundations/motion",
        "http://localhost:4173/examples/dashboard",
        "http://localhost:4173/getting-started"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}

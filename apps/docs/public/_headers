# Cloudflare Pages headers
# Equivalent to the headers() function in next.config.mjs (which is ignored in static export).

# Immutable cache for all hashed Next.js static assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Short cache + security headers for all HTML pages
/*
  Cache-Control: public, max-age=60, stale-while-revalidate=600
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), display-capture=(self)
  # Fallback policy. functions/_middleware.ts replaces it on HTML pages with a
  # per-request nonce + 'strict-dynamic' script-src (inline self.__next_f scripts
  # are page-specific, so hashes don't scale).
  # challenges.cloudflare.com = Turnstile; i.pravatar.cc = Avatar example images.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.pravatar.cc; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# React Native web preview (apps/mobile build:web → /m). Docs pages frame it,
# so here only, framing is allowed from this origin. Rules for a path combine
# (a header set twice is joined with a comma), so the /* values are detached
# with "!" first; otherwise "DENY, SAMEORIGIN" would still block the frame.
# functions/_middleware.ts sets the same two headers on /m HTML responses.
/m/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.pravatar.cc; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# Page-template frames (/frame/<slug>) are framed by the docs pages the same way.
/frame/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.pravatar.cc; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

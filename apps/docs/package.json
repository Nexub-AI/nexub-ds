{
  "name": "@nexub/docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-ai-md.mjs && next dev --turbopack",
    "build": "pnpm run build:mobile-web && node scripts/copy-device-shots.mjs && node scripts/copy-ai-md.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build:mobile-web": "turbo run build:web --filter=@nexub/mobile --output-logs=errors-only && node ../mobile/scripts/copy-web.mjs public/m"
  },
  "dependencies": {
    "@nexub/icons": "workspace:*",
    "@nexub/marketing": "workspace:*",
    "@nexub/patterns": "workspace:*",
    "@nexub/react": "workspace:*",
    "@nexub/themes": "workspace:*",
    "@nexub/tokens": "workspace:*",
    "cmdk": "^1.1.1",
    "html-to-image": "^1.11.13",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^15.5.28",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "wrangler": "3.114.17"
  }
}

{
  "name": "@nexub/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "preview-manifest": "node --experimental-strip-types --no-warnings scripts/preview-manifest.mjs",
    "test": "node --experimental-strip-types --no-warnings scripts/preview-manifest.mjs --check && node --test scripts/screenshots.test.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@nexub/icons": "workspace:*",
    "@nexub/react-native": "workspace:*",
    "@react-native-community/datetimepicker": "9.3.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-screen-capture": "~58.0.6",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  }
}

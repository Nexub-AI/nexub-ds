{
  "name": "@nexub/marketing",
  "version": "5.5.0",
  "description": "Marketing sections for the Nexub Design System: hero, stats, testimonials, products, pricing, FAQ, CTA, nav and footer, built on @nexub/react in marketing mode. Server components by default.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Nexub-AI/nexub-ds#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexub-AI/nexub-ds.git",
    "directory": "packages/marketing"
  },
  "keywords": [
    "react",
    "marketing",
    "landing-page",
    "server-components",
    "design-system",
    "nexub"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsup && tsc -p tsconfig.build.json && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@nexub/icons": "workspace:^",
    "@nexub/patterns": "workspace:^",
    "@nexub/react": "workspace:^",
    "@nexub/themes": "workspace:^",
    "@nexub/tokens": "workspace:^",
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "peerDependenciesMeta": {
    "@nexub/icons": {
      "optional": true
    },
    "@nexub/tokens": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nexub/icons": "workspace:*",
    "@nexub/patterns": "workspace:*",
    "@nexub/react": "workspace:*",
    "@nexub/themes": "workspace:*",
    "@nexub/tokens": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

{
  "name": "@nexub/mcp",
  "version": "1.5.1",
  "description": "MCP server for Nexub Design System: gives Claude, Cursor and any MCP client the components, patterns, tokens and design rules of the installed release.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Nexub-AI/nexub-ds#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexub-AI/nexub-ds.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-system",
    "claude",
    "nexub"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "dist"
  ],
  "bin": {
    "nexub-mcp": "./src/cli.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('../../plugins/nexub-ds/skills/nexub-ds','dist/skill',{recursive:true})\"",
    "clean": "rm -rf dist",
    "test": "node --test src/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.6.7"
  }
}

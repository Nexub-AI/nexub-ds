{
  "name": "@nexub/icons",
  "version": "1.0.0",
  "description": "Icon components for Nexub Design System \u2014 tree-shakeable React wrappers around Lucide icons with design-system size tokens.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Nexub-AI/nexub-ds#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexub-AI/nexub-ds.git",
    "directory": "packages/icons"
  },
  "keywords": [
    "icons",
    "react",
    "lucide",
    "design-system",
    "nexub"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}

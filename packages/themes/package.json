{
  "name": "@nexub/themes",
  "version": "11.9.0",
  "description": "CSS theme files for Nexub Design System — light, dark, and brand themes (the five Nexub divisions and every app) as importable CSS.",
  "license": "MIT",
  "homepage": "https://github.com/Nexub-AI/nexub-ds#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexub-AI/nexub-ds.git",
    "directory": "packages/themes"
  },
  "keywords": [
    "themes",
    "css",
    "dark-mode",
    "design-system",
    "nexub"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "./src/**/*.css"
  ],
  "exports": {
    "./base": "./src/base.css",
    "./core": "./src/core.css",
    "./fonts": "./src/fonts.css",
    "./light": "./src/light.css",
    "./dark": "./src/dark.css",
    "./glass": "./src/glass.css",
    "./view-transitions": "./src/view-transitions.css",
    "./divisions": "./src/divisions.css",
    "./divisions/os": "./src/divisions/os.css",
    "./divisions/commerce": "./src/divisions/commerce.css",
    "./divisions/fintech": "./src/divisions/fintech.css",
    "./divisions/intelligence": "./src/divisions/intelligence.css",
    "./divisions/autonomous": "./src/divisions/autonomous.css",
    "./products": "./src/products.css",
    "./marketing": "./src/marketing.css",
    "./vivid": "./src/vivid.css"
  },
  "scripts": {
    "build:fonts": "node scripts/build-fonts.mjs",
    "build:products": "node scripts/build-products.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "iOS >= 17.5"
  ],
  "dependencies": {
    "@nexub/tokens": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "browserslist": "4.29.5",
    "lightningcss": "1.33.0"
  }
}

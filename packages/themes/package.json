{
  "name": "@nexub/themes",
  "version": "9.3.0",
  "description": "CSS theme files for Nexub Design System — light, dark, and brand themes (Leap, Bookub, Payub, Founderub) as importable CSS.",
  "license": "MIT",
  "homepage": "https://github.com/Nexub-AI/nexub-ds#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexub-AI/nexub-ds.git",
    "directory": "packages/themes"
  },
  "keywords": [
    "themes",
    "css",
    "dark-mode",
    "design-system",
    "nexub"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "./src/*.css"
  ],
  "exports": {
    "./base": "./src/base.css",
    "./core": "./src/core.css",
    "./fonts": "./src/fonts.css",
    "./light": "./src/light.css",
    "./dark": "./src/dark.css",
    "./glass": "./src/glass.css",
    "./view-transitions": "./src/view-transitions.css",
    "./leap": "./src/leap.css",
    "./bookub": "./src/bookub.css",
    "./payub": "./src/payub.css",
    "./founderub": "./src/founderub.css",
    "./marketing": "./src/marketing.css",
    "./vivid": "./src/vivid.css"
  },
  "scripts": {
    "build:fonts": "node scripts/build-fonts.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "iOS >= 17.5"
  ],
  "dependencies": {
    "@nexub/tokens": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "browserslist": "4.29.4",
    "lightningcss": "1.33.0"
  }
}

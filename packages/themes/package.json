{
  "name": "@nexub/themes",
  "version": "12.6.0",
  "description": "CSS theme files for Nexub Design System — light, dark, and brand themes (the five Nexub divisions and every app) as importable CSS.",
  "license": "MIT",
  "homepage": "https://github.com/Nexub-AI/nexub-ds#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexub-AI/nexub-ds.git",
    "directory": "packages/themes"
  },
  "keywords": [
    "themes",
    "css",
    "dark-mode",
    "design-system",
    "nexub"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "./src/**/*.css",
    "./dist/**/*.css"
  ],
  "exports": {
    "./base": "./dist/base.css",
    "./base-lean": "./dist/base-lean.css",
    "./core": "./dist/core.css",
    "./core-lean": "./dist/core-lean.css",
    "./fonts": "./dist/fonts.css",
    "./light": "./dist/light.css",
    "./dark": "./dist/dark.css",
    "./glass": "./dist/glass.css",
    "./view-transitions": "./dist/view-transitions.css",
    "./divisions": "./dist/divisions.css",
    "./divisions/os": "./dist/divisions/os.css",
    "./divisions/commerce": "./dist/divisions/commerce.css",
    "./divisions/fintech": "./dist/divisions/fintech.css",
    "./divisions/intelligence": "./dist/divisions/intelligence.css",
    "./divisions/autonomous": "./dist/divisions/autonomous.css",
    "./products": "./dist/products.css",
    "./marketing": "./dist/marketing.css",
    "./vivid": "./dist/vivid.css",
    "./parts/*.css": "./dist/parts/*.css",
    "./parts/index.json": "./dist/parts/index.json"
  },
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build:products": "node scripts/build-products.mjs",
    "test": "node --test scripts/*.test.mjs",
    "build:parts": "node scripts/build-parts.mjs"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "iOS >= 17.5"
  ],
  "dependencies": {
    "@nexub/tokens": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "browserslist": "4.29.6",
    "lightningcss": "1.33.0"
  }
}

{
  "name": "@nexub/diagram",
  "version": "11.9.0",
  "description": "Themed, keyboard-accessible diagram canvas for Nexub Design System, on React Flow (@xyflow/react, a peer dependency).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Nexub-AI/nexub-ds#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexub-AI/nexub-ds.git",
    "directory": "packages/diagram"
  },
  "keywords": [
    "react",
    "diagram",
    "react-flow",
    "design-system",
    "nexub"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && node ../react/scripts/build-nexub-layer.mjs src/styles.css dist/styles.css && node ../react/scripts/build-nexub-layer.mjs src/theme.css dist/theme.css",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@nexub/react": "workspace:^",
    "@xyflow/react": "^12.10.0",
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "@nexub/react": "workspace:*",
    "@nexub/tokens": "workspace:*",
    "@tailwindcss/cli": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "@xyflow/react": "^12.12.1"
  }
}

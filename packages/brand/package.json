{
  "name": "@nexub/brand",
  "version": "2.4.0",
  "description": "Official Nexub brand files: the Nexub mark (colour and mono SVG), app icon tiles, PNG icons and favicon.",
  "license": "MIT",
  "homepage": "https://github.com/Nexub-AI/nexub-ds#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexub-AI/nexub-ds.git",
    "directory": "packages/brand"
  },
  "keywords": [
    "brand",
    "logo",
    "icons",
    "favicon",
    "nexub"
  ],
  "publishConfig": {

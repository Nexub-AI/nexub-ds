{
  "name": "@nexub/tokens",
  "version": "7.1.0",
  "description": "Design tokens for Nexub Design System — colours, typography, spacing, radii, shadows, and motion as CSS variables, a Tailwind 4 theme, Figma variables and native (React Native, SwiftUI, Compose) tokens.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Nexub-AI/nexub-ds#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexub-AI/nexub-ds.git",
    "directory": "packages/tokens"
  },
  "keywords": [
    "design-tokens",
    "css-variables",
    "tailwind",
    "design-system",
    "nexub"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "nexub-migrate": "./bin/nexub-migrate.mjs",
    "nexub-usage": "./bin/nexub-usage.mjs"
  },
  "files": [
    "dist",
    "bin",
    "!bin/*.test.mjs"
  ],
  "sideEffects": [
    "./dist/css/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./css": "./dist/css/variables.css",
    "./css/roles": "./dist/css/roles.css",
    "./css/rem": "./dist/css/rem.css",
    "./seed": {
      "types": "./dist/js/seed.d.ts",
      "default": "./dist/js/seed.js"
    },
    "./native": {
      "types": "./dist/js/native.d.ts",
      "default": "./dist/js/native.js"
    },
    "./tailwind.css": "./dist/tailwind/theme.css",
    "./json": "./dist/json/tokens.json",
    "./json/component": "./dist/json/component.json",
    "./figma/*": "./dist/figma/*",
    "./swift/*": "./dist/swift/*",
    "./compose/*": "./dist/compose/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build.mjs --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test scripts/*.test.mjs bin/*.test.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.3.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}

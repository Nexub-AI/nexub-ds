{
  "name": "@nexub/tokens",
  "version": "1.5.0",
  "description": "Design tokens for Nexub Design System — colours, typography, spacing, radii, shadows, and motion as CSS variables and Tailwind preset.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Nexub-AI/nexub-ds#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexub-AI/nexub-ds.git",
    "directory": "packages/tokens"
  },
  "keywords": [
    "design-tokens",
    "css-variables",
    "tailwind",
    "design-system",
    "nexub"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/css/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./css": "./dist/css/variables.css",
    "./css/roles": "./dist/css/roles.css",
    "./tailwind": {
      "types": "./dist/tailwind/preset.d.ts",
      "default": "./dist/tailwind/preset.js"
    },
    "./json": "./dist/json/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build.mjs --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.3.0",
    "style-dictionary": "^4.3.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "tailwindcss": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}

{
  "name": "@nexub/patterns",
  "version": "0.0.2",
  "description": "Composite UI patterns for Nexub Design System \u2014 pre-built, production-ready layouts and widgets built on @nexub/react.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Nexub-AI/nexub-ds#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexub-AI/nexub-ds.git",
    "directory": "packages/patterns"
  },
  "keywords": [
    "react",
    "patterns",
    "ui",
    "design-system",
    "nexub"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "@nexub/react": "*",
    "@nexub/icons": "*",
    "@nexub/tokens": "*"
  },
  "peerDependenciesMeta": {
    "@nexub/icons": {
      "optional": true
    },
    "@nexub/tokens": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nexub/icons": "workspace:*",
    "@nexub/react": "workspace:*",
    "@nexub/tokens": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
